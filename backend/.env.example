# ==============================================================================
# FixMyForm AI - Backend Environment Configuration
# STRICT CONSTRAINT: Gemma is the ONLY AI model used for document understanding.
# DigitalOcean is explicitly NOT permitted. Non-Gemma proprietary models are rejected.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Backboard API (Recommended for Unified Multi-Model Infrastructure)
# ------------------------------------------------------------------------------
# 1. Provide your Backboard API Key:
BACKBOARD_API_KEY=your_backboard_api_key_here

# 2. Backboard API Base Endpoint (Official Backboard API endpoint):
BACKBOARD_API_ENDPOINT=https://app.backboard.io/api

# 3. Provider within Backboard (e.g. google, openrouter):
BACKBOARD_PROVIDER=google

# 4. Gemma Model Name (Must be a Gemma model):
GEMMA_MODEL=google/gemma-3-12b-it

# ------------------------------------------------------------------------------
# OPTION B: Alternative OpenAI-Compatible Gemma Endpoint (Groq / OpenRouter / Ollama)
# ------------------------------------------------------------------------------
# If not using Backboard, you can configure GEMMA_API_KEY and GEMMA_API_ENDPOINT:
# GEMMA_API_KEY=your_groq_or_openrouter_key
# GEMMA_API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# GEMMA_MODEL=google/gemma-4

# ------------------------------------------------------------------------------
# Optional Settings
# ------------------------------------------------------------------------------
# Tesseract OCR executable path (e.g., C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=

# Set to true to force Demo Mode with verified sample forms:
DEMO_MODE_FORCED=false
